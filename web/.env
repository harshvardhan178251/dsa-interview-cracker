# Local defaults — committed so a fresh clone builds without extra setup.
# Override locally in `.env.local` (git-ignored) or in your CI environment.

# The public origin of the deployed site. Used for the canonical link, the
# Open Graph tags, the sitemap and the structured data.
#
#   Vercel       https://your-app.vercel.app
#   Netlify      https://your-app.netlify.app
#   GitHub Pages https://<user>.github.io/<repo>
#   Custom       https://dsa.example.com
VITE_SITE_URL=http://localhost:5173

# The path the site is served from. Leave as / for a root deployment
# (Vercel, Netlify, nginx, Docker). GitHub Pages needs /<repo>/.
BASE_PATH=/

# Where the source lives — used to turn ".java" links in the write-ups into
# working links to the repository.
VITE_REPO_URL=https://github.com/harshvardhan178251/dsa-interview-cracker

# Where the dev server proxies /api to during development.
API_TARGET=http://localhost:4173
